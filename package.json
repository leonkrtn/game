{
  "name": "rien-ne-va-plus",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "vite build --mode single && node scripts/embed-gltf.mjs dist-single/assets",
    "build:offline": "npm run build:single && node scripts/offline.mjs",
    "preview": "vite preview",
    "test": "vitest run tests",
    "typecheck": "tsc --noEmit",
    "sim": "vitest run scripts/sim.test.ts"
  },
  "dependencies": {
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.0",
    "@gltf-transform/extensions": "^4.5.0",
    "@gltf-transform/functions": "^4.5.0",
    "@types/node": "^26.6.2",
    "@types/three": "^0.186.0",
    "sharp": "^0.35.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.1"
  }
}
